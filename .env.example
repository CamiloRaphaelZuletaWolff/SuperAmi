# Copiar a .env y completar. NUNCA poner valores reales en este archivo (es público).

# Proveedor de modelos: gemini (producción) | nvidia | anthropic | ollama
PROVIDER=gemini
GEMINI_API_KEY=tu-api-key-de-google-ai-studio
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
MODELO_POTENTE=gemini-flash-latest
MODELO_ECONOMICO=gemini-flash-lite-latest
MODELO_EMBEDDINGS=gemini-embedding-001
EMBEDDING_DIM=1024

# Postgres + pgvector. Local: docker compose (puerto del docker-compose.yml).
# Producción: cadena de Neon con ?sslmode=require
DATABASE_URL=postgresql://ami:ami@localhost:5434/ami

# Frontend web (orígenes permitidos, separados por coma) y límite de /chat por IP
CORS_ORIGINS=http://localhost:3000
CHAT_RATE_LIMIT_PER_MIN=12

# WhatsApp Cloud API (webhook en api/whatsapp.py)
# WHATSAPP_TOKEN: token de System User (permanente) — ver DEPLOY.md, sección WhatsApp
# WHATSAPP_PHONE_NUMBER_ID: Meta App Dashboard > WhatsApp > API Setup
# WHATSAPP_VERIFY_TOKEN: string inventado por vos; el mismo en el dashboard de Meta
# WHATSAPP_APP_SECRET: App Dashboard > Configuración básica; habilita la validación de firma
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Alternativas de proveedor (opcionales)
# NVIDIA_API_KEY=
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# ANTHROPIC_API_KEY=
# VOYAGE_API_KEY=
# Open-source local (pip install -r requirements-oss.txt + Ollama corriendo):
# PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
